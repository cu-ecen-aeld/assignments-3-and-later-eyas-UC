
#!/bin/sh

case "$1" in
    start)
        echo "Loading aesd char device ..."
        ./aesdchar_load
    
    
    
    ;;
    stop)

        echo "Stopping aesd char device ..."

        ./aesdchar_unload
        ;;


    *)
        echo "Usage: $0 {start|stop}"
        exit 1
    ;;
esac
    exit 0